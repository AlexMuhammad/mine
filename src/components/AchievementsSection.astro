---
import type { Lang } from "../i18n/translations";
import { t } from "../i18n/translations";
import { achievements } from "../i18n/data";
import SectionHeader from "./SectionHeader.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<section id="achievements" class="mb-20">
  <SectionHeader title={t(lang, "section.achievements")} icon="trophy" />

  <ul class="divide-y divide-gray-100">
    {achievements.map((item) => (
      <li class="grid grid-cols-[60px_1fr] sm:grid-cols-[80px_1fr_1fr] items-center gap-x-4 py-3">
        <span class="text-sm font-secondary text-gray-400 tabular-nums">
          {item.date.split("-")[0]}
        </span>

        <div class="flex items-center gap-2 min-w-0">
          {item.url ? (
            <a
              href={item.url}
              target="_blank"
              rel="noopener noreferrer"
              class="text-sm font-primary font-medium text-gray-900 truncate hover:text-primary-500 hover:underline underline-offset-4 decoration-1 transition-colors"
            >
              {item.title[lang]}
            </a>
          ) : (
            <span class="text-sm font-primary font-medium text-gray-900 truncate">
              {item.title[lang]}
            </span>
          )}
        </div>

        <span class="col-span-2 sm:col-span-1 text-sm font-secondary text-gray-400 truncate sm:pl-0 pl-16">
          {item.issuer}
        </span>
      </li>
    ))}
  </ul>
</section>
