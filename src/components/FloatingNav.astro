---
import LanguageSwitcher from "./LanguageSwitcher";
import Icon from "./Icon";

interface Props {
  lang?: "en" | "id";
}

const { lang = "en" } = Astro.props;
---

<nav class="fixed bottom-6 left-1/2 -translate-x-1/2 z-50">
  <div class="flex items-center gap-1 px-3 py-2.5 rounded-full bg-white/80 backdrop-blur-xl border border-gray-200 shadow-lg shadow-black/5">
    <!-- Home -->
    <a href="#about" class="nav-icon-link p-2.5 rounded-full hover:bg-gray-100 transition-colors" aria-label="Home">
      <Icon name="home" size={20} className="text-gray-800" client:load />
    </a>

    <!-- Divider -->
    <div class="w-px h-5 bg-gray-200 mx-1"></div>

    <!-- GitHub -->
    <a href="https://github.com/AlexMuhammad" target="_blank" rel="noopener noreferrer" class="p-2.5 rounded-full hover:bg-gray-100 transition-colors" aria-label="GitHub">
      <Icon name="github" size={20} className="text-gray-800" client:load />
    </a>

    <!-- LinkedIn -->
    <a href="https://www.linkedin.com/in/muh-alex-saputra" target="_blank" rel="noopener noreferrer" class="p-2.5 rounded-full hover:bg-gray-100 transition-colors" aria-label="LinkedIn">
      <Icon name="linkedin" size={20} className="text-gray-800" client:load />
    </a>

    <!-- Divider -->
    <div class="w-px h-5 bg-gray-200 mx-1"></div>

    <!-- Language Switcher -->
    <LanguageSwitcher currentLang={lang} client:load />
  </div>
</nav>
