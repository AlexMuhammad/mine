---
import type { Lang } from "../i18n/translations";
import { t } from "../i18n/translations";
import { experiences } from "../i18n/data";
import SectionHeader from "./SectionHeader.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const INITIAL_COUNT = 10;
const hasMore = experiences.length > INITIAL_COUNT;
---

<section id="experience" class="mb-20">
  <SectionHeader title={t(lang, "section.experience")} icon="briefcase" />

  <ul class="divide-y divide-gray-100" id="experience-list">
    {experiences.map((exp, i) => (
      <li
        class:list={[
          "exp-item grid grid-cols-[60px_1fr] sm:grid-cols-[80px_1fr_1fr] items-center gap-x-4 py-3",
          i >= INITIAL_COUNT && "hidden",
        ]}
      >
        <span class="text-sm font-secondary text-gray-400 tabular-nums">
          {exp.startDate.split("-")[0]}
        </span>

        <div class="flex items-center gap-2 min-w-0">
          {exp.url ? (
            <a
              href={exp.url}
              target="_blank"
              rel="noopener noreferrer"
              class="text-sm font-primary font-medium text-gray-900 truncate hover:text-primary-500 hover:underline underline-offset-4 decoration-1 transition-colors"
            >
              {exp.company}
            </a>
          ) : (
            <span class="text-sm font-primary font-medium text-gray-900 truncate">
              {exp.company}
            </span>
          )}
          {exp.endDate === null && (
            <span class="shrink-0 px-1.5 py-0.5 rounded-sm border border-gray-200 text-[10px] font-secondary text-gray-500 uppercase tracking-wide">
              Now
            </span>
          )}
        </div>

        <span class="col-span-2 sm:col-span-1 text-sm font-secondary text-gray-400 truncate sm:pl-0 pl-16">
          {exp.title[lang]}
        </span>
      </li>
    ))}
  </ul>

  {hasMore && (
    <button
      id="exp-toggle"
      class="mt-4 text-xs font-primary font-bold uppercase tracking-widest text-gray-500 hover:text-primary-500 transition-colors"
    >
      {lang === "en" ? `Show More (${experiences.length - INITIAL_COUNT})` : `Tampilkan Lagi (${experiences.length - INITIAL_COUNT})`}
    </button>
  )}
</section>

<script>
  const btn = document.getElementById("exp-toggle");
  let expanded = false;

  if (btn) {
    btn.dataset.moreText = btn.textContent ?? "";
    btn.dataset.lessText = document.documentElement.lang === "id" ? "Tampilkan Sedikit" : "Show Less";
  }

  btn?.addEventListener("click", () => {
    expanded = !expanded;

    if (expanded) {
      document.querySelectorAll(".exp-item.hidden").forEach((el) => {
        el.classList.remove("hidden");
        el.setAttribute("data-was-hidden", "");
      });
      btn.textContent = btn.dataset.lessText ?? "Show Less";
    } else {
      document.querySelectorAll(".exp-item[data-was-hidden]").forEach((el) => {
        el.classList.add("hidden");
        el.removeAttribute("data-was-hidden");
      });
      btn.textContent = btn.dataset.moreText ?? btn.textContent;
    }
  });
</script>
